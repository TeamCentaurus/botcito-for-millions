      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(tree:*)",
      "Bash(find:*)",
      "Bash(rg:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(file:*)",
      "Bash(stat:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)",
      "Bash(git ls-files:*)",
      "Bash(git blame:*)",
      "Bash(uv sync:*)",
      "Bash(uv add:*)",
      "Bash(uv lock:*)",
      "Bash(uv tree:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run python:*)",
      "Bash(uv run jupyter:*)",
      "Bash(python -m json.tool:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose config:*)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)",
      "Bash(gcloud config get-value:*)",
      "Bash(gcloud projects describe:*)",
      "Bash(gcloud projects list:*)",
      "Bash(gcloud functions list:*)",
      "Bash(gcloud functions describe:*)",
      "Bash(gcloud pubsub topics list:*)",
      "Bash(gcloud pubsub subscriptions list:*)",
      "Bash(gcloud scheduler jobs list:*)",
      "Bash(gcloud scheduler jobs describe:*)",
      "Bash(gcloud iam service-accounts list:*)",
      "Bash(gcloud storage ls:*)",
      "Bash(gcloud compute instances list:*)",
